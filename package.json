{
  "name": "maers-qls",
  "version": "0.1.0",
  "description": "MAERS QLS — 统一生活量化与时间管理系统（纯前端，运行时零依赖）",
  "license": "GPL-3.0-or-later",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/dev-server.js",
    "build": "node scripts/build-static.js",
    "build:exe": "node scripts/build-desktop-app.js",
    "build:precache": "node scripts/build-precache.js",
    "pretest": "node scripts/build-precache.js",
    "pretest:coverage": "node scripts/build-precache.js",
    "test": "node --test --experimental-test-isolation=none \"tests/**/*.test.js\"",
    "test:e2e": "node --test \"tests/e2e/*.e2e.js\"",
    "test:coverage": "node --test --experimental-test-isolation=none --experimental-test-coverage --test-coverage-lines=80 --test-coverage-branches=70 --test-coverage-functions=75 --test-coverage-exclude=\"tests/**\" --test-coverage-exclude=\"node_modules/**\" \"tests/**/*.test.js\"",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.4",
    "espree": "^10.4.0",
    "fake-indexeddb": "^6.2.6",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "playwright-core": "^1.64.1"
  }
}
